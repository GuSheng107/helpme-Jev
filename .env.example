# HelpMe JEV 环境变量
# 复制本文件为 .env 后按需修改。.env 已加入 .gitignore，绝不会入库。

# 【必填】Secret 加密根密钥
# 32 字节 CSPRNG 的 base64url 编码（恰好 43 个字符）
# 生成方式（任选其一）：
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
#   或  powershell -c "[Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))"
# 该密钥用于派生 AES-256-GCM 密钥来加密用户配置的 apiKey。
# 一旦更换，已存储的密文将无法解密（需重新填写密钥）。
APP_SECRET=

# 【可选】默认管理员（仅在**首次启动且库中无任何用户**时创建）
# 默认值：admin / helpme-jev-admin-2026!
# 首次登录会强制改密（密码需 ≥10 位且含字母、数字、符号）。
# 生产部署建议启动后立即登录改密，或在此处先改掉再启动。
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=helpme-jev-admin-2026!

# 服务端口（默认 8790）
PORT=8790

# 数据库文件路径（默认 ./data/helpme_jev.db）
DATABASE_PATH=./data/helpme_jev.db

# 日志与聊天记录保留天数（默认 15）
RETENTION_DAYS=15

# session 有效期（小时，默认 8）
SESSION_TTL_HOURS=8
